# Copy to .env.local for local development. Never commit real values.

# Postgres connection. Local Docker: the line below. Neon: paste the connection string
# from the Neon dashboard (keep ?sslmode=require at the end).
DATABASE_URL=postgresql://qtech:qtech_dev_password@localhost:5432/qtech
DATABASE_POOL_MAX=30

# The address people open the app at. Used for invite/reset links and cookie security
# (https → Secure, __Host- cookie).
APP_URL=http://localhost:3000

# Only "true" behind a reverse proxy that sets X-Forwarded-For (Railway, Render, nginx).
TRUST_PROXY=false

# Where uploaded files are stored locally (git-ignored)
STORAGE_LOCAL_DIR=./.data/storage
# Vercel Blob (private store). When set, files go there instead of STORAGE_LOCAL_DIR.
# Copy existing local files across once with: npm run storage:to-blob
BLOB_READ_WRITE_TOKEN=
UPLOAD_MAX_MB=50

# Integration and browser tests only. The database name MUST end in _test:
# it is wiped on every test run.
TEST_DATABASE_URL=postgresql://qtech:qtech_dev_password@localhost:5432/qtech_test

# Optional: fill client details from a GSTIN (Cashfree Verification Suite → Developers → API keys).
# Leave empty to switch the lookup off. Start with sandbox keys; switch to production keys and
# CASHFREE_ENV=production for real lookups (charged per lookup by Cashfree).
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
# Only if your Cashfree account uses "Public Key" 2FA instead of IP whitelisting (PEM, \n for line breaks):
CASHFREE_PUBLIC_KEY=

# Email for alerts and the daily digest (optional). Without a key nothing is
# emailed and the in-app bell still works. Verify the sender's domain at resend.com.
RESEND_API_KEY=
MAIL_FROM=
# A long random string (24+ characters); the host's scheduler calls
# /api/cron/digest once a day with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Reads the field engineer's layout sketch (PDF or photo) into a diagram (optional).
# Claude is used when its key is set (console.anthropic.com → API keys; billed
# separately from a Claude Pro plan). About 10 paise a photo on Claude Haiku.
ANTHROPIC_API_KEY=
CLAUDE_SKETCH_MODEL=claude-haiku-5-5
# Or OpenAI:
# platform.openai.com → API keys. About 10-50 paise per sketch on gpt-5-mini.
OPENAI_API_KEY=
OPENAI_SKETCH_MODEL=gpt-5-mini
