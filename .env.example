# Copy to .env.local for local development. Never commit real values.

# Local dev: the Postgres from docker-compose.yml
DATABASE_URL=postgresql://qtech:qtech_dev_password@localhost:5432/qtech
DATABASE_POOL_MAX=10

# Where uploaded files are stored locally (git-ignored)
STORAGE_LOCAL_DIR=./.data/storage
UPLOAD_MAX_MB=50

# Integration tests only. Must be a database whose name ends in _test (it is wiped on every run).
TEST_DATABASE_URL=postgresql://qtech:qtech_dev_password@localhost:5432/qtech_test
